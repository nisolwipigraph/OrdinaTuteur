<!-- Внешний вид окна. Реакция на кнопки написана в MainWindow.xaml.cs. -->
<Window
    x:Class="OrdinaTuteur.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OrdinaTuteur">
    <!-- Полупрозрачный фон в стиле Windows 11. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- Сверху чат занимает всё свободное место, снизу поле ввода и кнопка. -->
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Чат прокручивается отдельно от поля ввода. -->
        <ScrollViewer
            x:Name="ChatScroll"
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto">
            <!-- C# добавляет сюда карточки сообщений по одной. -->
            <StackPanel
                x:Name="ChatMessages"
                Spacing="12"
                Padding="0,0,8,0" />
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Enter вызывает PromptInput_KeyDown и отправляет задачу. -->
            <TextBox
                x:Name="PromptInput"
                Grid.Column="0"
                PlaceholderText="Напишите сообщение..."
                FontSize="15"
                MinHeight="48"
                VerticalContentAlignment="Center"
                AcceptsReturn="False"
                KeyDown="PromptInput_KeyDown" />

            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Content="Отправить"
                MinHeight="48"
                Padding="18,0"
                Click="SendButton_Click" />
        </Grid>
    </Grid>
</Window>
