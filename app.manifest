<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Имя, которое Windows видит у приложения. -->
  <assemblyIdentity version="1.0.0.0" name="OrdinaTuteur.app" />
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- 10.0.22621 — Windows 11. Тот же идентификатор ниже подходит и Windows 10. -->
      <maxversiontested Id="10.0.22621.0" />
      <!-- {8e0f7a12-...} означает современные Windows 10 и Windows 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- На каждом мониторе свой масштаб. Окно не мылится при переносе. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
