<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Имя и версия приложения, которые видит Windows. -->
  <assemblyIdentity version="1.0.0.0" name="OrdinaTuteur.app" />
  <!-- Windows использует эти сведения, чтобы проверить совместимость программы. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Версия Windows, на которой приложение было проверено. -->
      <maxversiontested Id="10.0.19041.0" />
      <!-- Идентификатор поддерживаемых современных версий Windows. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <!-- Настройки отображения окна на мониторах с разной плотностью пикселей. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Windows масштабирует окно отдельно для каждого монитора. -->
      <dpiAwareness
        xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
