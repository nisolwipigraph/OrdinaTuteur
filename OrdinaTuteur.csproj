<Project Sdk="Microsoft.NET.Sdk">

  <!-- Основные настройки сборки приложения. -->
  <PropertyGroup>
    <!-- Программа с окном, а не консольное приложение. -->
    <OutputType>WinExe</OutputType>
    <!-- Нужны .NET 10 и функции Windows из версии 10.0.19041.0 и новее. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Используем WinUI и запускаемся без установки MSIX-пакета. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Включаем нужные части Windows App SDK в собранное приложение. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Собираем 64-разрядную версию для Windows x64. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Компилятор предупреждает о переменных, которые могут содержать null. -->
    <Nullable>enable</Nullable>
    <!-- Часто используемые пространства имён доступны без отдельных using. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Этот файл задаёт настройки совместимости приложения с Windows. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Имя пространства имён по умолчанию для кода приложения. -->
    <RootNamespace>OrdinaTuteur</RootNamespace>
  </PropertyGroup>

  <!-- Библиотеки, от которых зависит сборка. -->
  <ItemGroup>
    <!-- WinUI даёт элементы окна и средства для Windows-приложений. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <!-- Набор инструментов Windows SDK нужен для сборки приложения. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
  </ItemGroup>

  <!-- Копируем эти Python-файлы рядом с приложением при сборке. -->
  <ItemGroup>
    <!-- brain.py получает ключ из этого файла во время работы. -->
    <None Update="AIKey.py" CopyToOutputDirectory="PreserveNewest" />
    <!-- C# запускает этот файл для снимков экрана и запросов к ИИ. -->
    <None Update="brain.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
