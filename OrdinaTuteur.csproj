<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Окно, а не чёрная консоль. -->
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 и функции Windows начиная с 10.0.19041. Подходит и Windows 11. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Самая старая Windows, на которую ещё можно поставить сборку. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- WinUI без упаковки в магазинный MSIX: запускается обычный exe. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Нужные части Windows App SDK кладутся рядом с exe.
         На другом компьютере отдельно ставить среду выполнения окна не нужно. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Только 64-bit Windows. OrdinaTuteur.sln собирает ту же платформу. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Компилятор предупреждает, если значение может быть пустым. -->
    <Nullable>enable</Nullable>
    <!-- Частые пространства имён подключаются сами, без длинного списка using. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>OrdinaTuteur</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Элементы окна WinUI. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <!-- Инструменты сборки Windows SDK. Ставятся через NuGet при первой сборке. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
  </ItemGroup>

  <!-- Копируем Python рядом с exe. Рабочая папка программы — эта папка,
       поэтому brain.py находит AIKey.py без абсолютного пути. -->
  <ItemGroup>
    <None Update="AIKey.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="brain.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
